ENVIRONMENT=development
DATABASE_URL=auto
SESSION_SECRET=CHANGE_TO_AT_LEAST_32_RANDOM_BYTES
MEDIA_STORAGE_TYPE=smb
MEDIA_ROOT=/app/external-media
GENERATED_ROOT=/app/data/generated
UPLOAD_ROOT=/app/data/uploads
TIMEZONE=Europe/Berlin
APP_PUBLIC_BASE_URL=http://localhost:8000
LEGAL_CONTROLLER_NAME="SV Blau Weiß Ehlen 1901 e.V."
LEGAL_CONTROLLER_STREET="Erleweg 20"
LEGAL_CONTROLLER_CITY="34317 Habichtswald-Ehlen"
LEGAL_CONTACT_EMAIL=socialmedia@svehlen.de
LEGAL_IMPRINT_URL=https://www.svehlen.de/impressum-datenschutz
LEGAL_PRIVACY_EFFECTIVE_DATE="11. August 2026"
OPENAI_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_TOOL_MODEL=gpt-5.4-mini
OPENAI_IMAGE_QUALITY=medium
OPENAI_API_KEY=
TEXT_GENERATOR_MODE=mock
# playwright = reproduzierbarer Offline-Fallback; openai = KI-Grafiken
IMAGE_GENERATOR_MODE=playwright
META_GRAPH_VERSION=v23.0
META_ACCESS_TOKEN=
META_FACEBOOK_APP_ID=
META_FACEBOOK_APP_SECRET=
META_FACEBOOK_OAUTH_REDIRECT_URI=
META_WHATSAPP_CONFIGURATION_ID=
META_WEBHOOK_VERIFY_TOKEN=
# Regulär aktiv; nur für eine bewusste plattformweite Betriebspause deaktivieren.
FACEBOOK_CHANNEL_ENABLED=true
WHATSAPP_CHANNEL_ENABLED=true
PUBLISHER_MODE=dry-run
GLOBAL_PUBLISH_ENABLED=false
MEDIA_HOST_ROOT=./data/external-media
FUSSBALL_LIVE_TEST_ENABLED=false
LIVE_CENTER_ENABLED=true
LIVE_EVENT_AI_PARSING_ENABLED=false
LIVE_EVENT_AI_MODEL=gpt-5-mini
LIVE_EVENT_REPORTER_RATE_LIMIT_PER_MINUTE=12
LIVE_EVENT_GAME_WINDOW_BEFORE_MINUTES=180
LIVE_EVENT_GAME_WINDOW_AFTER_MINUTES=420
LIVE_EVENT_ACTIVE_GAME_TTL_MINUTES=480
FUSSBALL_AUTOMATIC_SYNC_ENABLED=false
AUTOMATIC_POST_GENERATION_ENABLED=false
FUSSBALL_SYNC_INTERVAL_SECONDS=1800
FUSSBALL_RESULT_POLL_INTERVAL_SECONDS=300
FUSSBALL_RESULT_MIN_AGE_MINUTES=120
FUSSBALL_RESULT_STABILITY_SECONDS=600
FUSSBALL_RESULT_MAX_AGE_HOURS=48
FUSSBALL_DECODE_OBFUSCATED_RESULTS=true
# FuPa-Spielberichte. Der lesende Abruf, die automatische Erzeugung und eine
# spätere Provider-Übertragung besitzen getrennte, standardmäßig geschlossene Gates.
FUPA_REPORTS_ENABLED=false
FUPA_REPORT_AUTOMATIC_GENERATION_ENABLED=false
FUPA_REPORT_AUTOMATIC_PUBLISH_ENABLED=false
FUPA_REPORT_POLL_INTERVAL_SECONDS=900
FUPA_REPORT_FIRST_CHECK_MINUTES=30
FUPA_REPORT_MAX_POLL_HOURS=6
FUPA_REPORT_BATCH_SIZE=5
# Providerneutrale Antwortfrist. Der frühere WhatsApp-Wert bleibt als
# Abwärtskompatibilitätswert lesbar, falls dieser Wert nicht gesetzt ist.
FUPA_REPORT_FEEDBACK_WAIT_MINUTES=30
FUPA_REPORT_WHATSAPP_WAIT_MINUTES=30
FUPA_REPORT_FEEDBACK_TEMPLATE_NAME=spielbericht_rueckfrage
FUPA_REPORT_FEEDBACK_TEMPLATE_LANGUAGE=de
FUPA_HTTP_TIMEOUT_SECONDS=20
# Telegram bleibt ohne PlatformAdmin- und Vereinsfreigabe inaktiv. Die
# Webhook-Basis muss öffentlich per HTTPS erreichbar sein; Bot-Tokens werden
# ausschließlich verschlüsselt in der Datenbank gespeichert.
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_LINK_TTL_MINUTES=30
TELEGRAM_HTTP_TIMEOUT_SECONDS=20
PROVIDER_SNAPSHOT_ROOT=/app/data/provider-snapshots

# Mandantenfähige SaaS-Plattform. In bestehenden Single-Tenant-Installationen erst
# nach erfolgreicher Vorprüfung und Migration aktivieren.
MULTI_TENANT_ENABLED=false
SELF_REGISTRATION_ENABLED=false
BILLING_ENABLED=false
PLATFORM_TIMEZONE=UTC
INITIAL_CLUB_ID=
INITIAL_CLUB_NAME=
INITIAL_CLUB_SHORT_NAME=
INITIAL_CLUB_SLUG=

# Privater Objektspeicher. Für die SaaS-Produktion ist cloudflare-r2 oder
# hetzner-object-storage vorgesehen; Zugangsdaten ausschließlich als Secrets injizieren.
OBJECT_STORAGE_PROVIDER=local
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_TTL_SECONDS=900
PUBLISHING_OBJECT_TTL_SECONDS=7200
