ENVIRONMENT=development
DATABASE_URL=auto
SESSION_SECRET=CHANGE_TO_AT_LEAST_32_RANDOM_BYTES
MEDIA_STORAGE_TYPE=smb
MEDIA_ROOT=/app/external-media
GENERATED_ROOT=/app/data/generated
TIMEZONE=Europe/Berlin
OPENAI_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_API_KEY=
TEXT_GENERATOR_MODE=mock
# playwright = reproduzierbarer Offline-Fallback; openai = KI-Grafiken
IMAGE_GENERATOR_MODE=playwright
META_GRAPH_VERSION=v23.0
META_ACCESS_TOKEN=
PUBLISHER_MODE=dry-run
GLOBAL_PUBLISH_ENABLED=false
MEDIA_HOST_ROOT=./data/external-media
FUSSBALL_LIVE_TEST_ENABLED=false
PROVIDER_SNAPSHOT_ROOT=/app/data/provider-snapshots
