ENVIRONMENT=staging
STAGING_DATA_ROOT=/srv/social-media-agent
STAGING_BACKUP_ROOT=/srv/social-media-agent-backups
SECRETS_ROOT=/etc/social-media-agent/secrets
MEDIA_HOST_ROOT=/mnt/social-media-assets
MEDIA_STORAGE_TYPE=smb
MEDIA_ROOT=/app/external-media
GENERATED_ROOT=/app/data/generated
UPLOAD_ROOT=/app/data/uploads
PROVIDER_SNAPSHOT_ROOT=/app/data/provider-snapshots
LOG_ROOT=/app/data/logs
BACKUP_ROOT=/app/data/backups
PUBLISHER_MODE=dry-run
GLOBAL_PUBLISH_ENABLED=false
META_ACCESS_TOKEN=
FUSSBALL_LIVE_TEST_ENABLED=false
OPENAI_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
# mock = FixtureTextGenerator; openai nur mit Secret-Datei openai_api_key
TEXT_GENERATOR_MODE=mock
# playwright = Offline-Fallback; openai nur nach eigenem Staging-Test
IMAGE_GENERATOR_MODE=playwright
HTTP_PORT=8080
TIMEZONE=Europe/Berlin
