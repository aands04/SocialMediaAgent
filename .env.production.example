ENVIRONMENT=production
PRODUCTION_DATA_ROOT=/srv/social-media-agent-production
PRODUCTION_BACKUP_ROOT=/srv/social-media-agent-production-backups
PRODUCTION_SECRETS_ROOT=/etc/social-media-agent/production-secrets
MEDIA_HOST_ROOT=/srv/social-media-assets
MEDIA_STORAGE_TYPE=local
MEDIA_ROOT=/app/external-media
GENERATED_ROOT=/app/data/generated
UPLOAD_ROOT=/app/data/uploads
PROVIDER_SNAPSHOT_ROOT=/app/data/provider-snapshots
LOG_ROOT=/app/data/logs
BACKUP_ROOT=/app/data/backups
PUBLISHER_MODE=instagram
META_TEST_ENABLED=false
META_TEST_PUBLISH_ENABLED=false
META_PRODUCTION_ENABLED=true
# Beim ersten Start bleiben alle drei Gates false. Erst nach der Abnahme gemeinsam aktivieren.
GLOBAL_PUBLISH_ENABLED=false
META_SCHEDULER_ENABLED=false
META_AUTOMATIC_PUBLISH_ENABLED=false
META_GRAPH_VERSION=v23.0
META_TOKEN_KEY_VERSION=v1
META_OAUTH_REDIRECT_URI=https://meta.svehlen.de/public/instagram/oauth/callback
META_PUBLIC_BASE_URL=https://meta.svehlen.de
# Facebook und WhatsApp stehen Vereinsadministratoren grundsätzlich zur Einrichtung bereit.
# Die Schalter nur für eine bewusste plattformweite Betriebspause auf false setzen.
META_FACEBOOK_APP_ID=
# Den allgemeinen Meta-App-Geheimcode niemals hier eintragen, sondern als geschützte Datei.
META_FACEBOOK_APP_SECRET_FILE_HOST=/dev/null
META_FACEBOOK_OAUTH_REDIRECT_URI=https://meta.svehlen.de/public/meta/channels/oauth/callback
META_WHATSAPP_CONFIGURATION_ID=
FACEBOOK_CHANNEL_ENABLED=true
WHATSAPP_CHANNEL_ENABLED=true
# META_WEBHOOK_VERIFY_TOKEN ausschließlich als Secret injizieren, nicht hier eintragen.
META_WEBHOOK_VERIFY_TOKEN_FILE_HOST=/dev/null
META_OAUTH_STATE_TTL_SECONDS=600
META_MEDIA_GRANT_TTL_SECONDS=3600
META_CONFIRMATION_TTL_SECONDS=300
META_HTTP_TIMEOUT_SECONDS=20
META_CONNECTION_MAX_AGE_SECONDS=86400
# Aktive Verbindungen werden zweimal täglich automatisch lesend geprüft.
META_CONNECTION_CHECK_INTERVAL_SECONDS=43200
META_CONTAINER_POLL_INTERVAL_SECONDS=30
META_CONTAINER_MAX_WAIT_SECONDS=900
META_SCHEDULER_BATCH_SIZE=5
FUSSBALL_LIVE_TEST_ENABLED=false
LIVE_CENTER_ENABLED=true
LIVE_EVENT_AI_PARSING_ENABLED=false
LIVE_EVENT_AI_MODEL=gpt-5-mini
LIVE_EVENT_REPORTER_RATE_LIMIT_PER_MINUTE=12
LIVE_EVENT_GAME_WINDOW_BEFORE_MINUTES=180
LIVE_EVENT_GAME_WINDOW_AFTER_MINUTES=420
LIVE_EVENT_ACTIVE_GAME_TTL_MINUTES=480
# Beide Gates beim ersten Rollout false lassen. Zuerst Regeln im Dashboard
# konfigurieren und einen manuellen Synchronisationslauf abnehmen.
FUSSBALL_AUTOMATIC_SYNC_ENABLED=false
AUTOMATIC_POST_GENERATION_ENABLED=false
FUSSBALL_SYNC_INTERVAL_SECONDS=1800
FUSSBALL_RESULT_POLL_INTERVAL_SECONDS=300
FUSSBALL_SYNC_ERROR_BACKOFF_SECONDS=300
FUSSBALL_SYNC_BATCH_SIZE=2
FUSSBALL_SYNC_LEASE_SECONDS=1800
FUSSBALL_RESULT_MIN_AGE_MINUTES=120
FUSSBALL_RESULT_STABILITY_SECONDS=600
FUSSBALL_RESULT_MAX_AGE_HOURS=48
FUSSBALL_DECODE_OBFUSCATED_RESULTS=true
TEXT_GENERATOR_MODE=openai
IMAGE_GENERATOR_MODE=openai
OPENAI_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_TOOL_MODEL=gpt-5.4-mini
OPENAI_IMAGE_QUALITY=medium
HTTP_PORT=8083
META_PUBLIC_PORT=8084
TIMEZONE=Europe/Berlin
APP_PUBLIC_BASE_URL=https://socialmedia.svehlen.de
# Öffentliche Pflichtangaben für Datenschutz- und Datenlöschungsseite.
LEGAL_CONTROLLER_NAME="SV Blau Weiß Ehlen 1901 e.V."
LEGAL_CONTROLLER_STREET="Erleweg 20"
LEGAL_CONTROLLER_CITY="34317 Habichtswald-Ehlen"
LEGAL_CONTACT_EMAIL=socialmedia@svehlen.de
LEGAL_IMPRINT_URL=https://www.svehlen.de/impressum-datenschutz
LEGAL_PRIVACY_EFFECTIVE_DATE="11. August 2026"
# Erst nach Einrichtung und Test des SMTP-Versands aktivieren.
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
EMAIL_CHANGE_TOKEN_TTL_SECONDS=1800
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=admin@svehlen.de
SMTP_FROM_EMAIL=admin@svehlen.de
SMTP_FROM_NAME=Vereinszentrale
SMTP_TIMEOUT_SECONDS=10
# Hostdatei mit dem SMTP-Passwort; bei deaktiviertem Reset darf /dev/null bleiben.
SMTP_PASSWORD_FILE_HOST=/dev/null
HOME=/tmp
XDG_CONFIG_HOME=/tmp/chromium-config
XDG_CACHE_HOME=/tmp/chromium-cache
