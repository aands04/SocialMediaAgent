ENVIRONMENT=meta-test
META_TEST_DATA_ROOT=/srv/social-media-agent-meta-test
META_TEST_BACKUP_ROOT=/srv/social-media-agent-meta-test-backups
META_TEST_SECRETS_ROOT=/etc/social-media-agent/meta-test-secrets
MEDIA_HOST_ROOT=/mnt/social-media-assets
MEDIA_ROOT=/app/external-media
GENERATED_ROOT=/app/data/generated
UPLOAD_ROOT=/app/data/uploads
PROVIDER_SNAPSHOT_ROOT=/app/data/provider-snapshots
LOG_ROOT=/app/data/logs
BACKUP_ROOT=/app/data/backups
PUBLISHER_MODE=instagram
GLOBAL_PUBLISH_ENABLED=false
META_TEST_ENABLED=true
# Erst unmittelbar vor OAuth/Verbindungsprüfung oder einem bewussten Meta-Test
# auf true setzen. Ohne dieses Gate erfolgen keinerlei externe Meta-Aufrufe.
META_TEST_PUBLISH_ENABLED=false
META_SCHEDULER_ENABLED=false
META_GRAPH_VERSION=v23.0
META_TOKEN_KEY_VERSION=v1
META_OAUTH_REDIRECT_URI=https://meta-test.example.org/public/instagram/oauth/callback
META_PUBLIC_BASE_URL=https://meta-test.example.org
META_FACEBOOK_APP_ID=
# Den allgemeinen Meta-App-Geheimcode niemals hier eintragen, sondern als geschützte Datei.
META_FACEBOOK_APP_SECRET_FILE_HOST=/dev/null
META_FACEBOOK_OAUTH_REDIRECT_URI=https://meta-test.example.org/public/meta/channels/oauth/callback
META_WHATSAPP_CONFIGURATION_ID=
FACEBOOK_CHANNEL_ENABLED=true
WHATSAPP_CHANNEL_ENABLED=true
# META_WEBHOOK_VERIFY_TOKEN ausschließlich als Secret injizieren, nicht hier eintragen.
META_WEBHOOK_VERIFY_TOKEN_FILE_HOST=/dev/null
META_OAUTH_STATE_TTL_SECONDS=600
META_MEDIA_GRANT_TTL_SECONDS=3600
META_CONFIRMATION_TTL_SECONDS=300
META_HTTP_TIMEOUT_SECONDS=20
FUSSBALL_LIVE_TEST_ENABLED=false
LIVE_CENTER_ENABLED=true
LIVE_EVENT_AI_PARSING_ENABLED=false
LIVE_EVENT_AI_MODEL=gpt-5-mini
LIVE_EVENT_REPORTER_RATE_LIMIT_PER_MINUTE=12
LIVE_EVENT_GAME_WINDOW_BEFORE_MINUTES=180
LIVE_EVENT_GAME_WINDOW_AFTER_MINUTES=420
LIVE_EVENT_ACTIVE_GAME_TTL_MINUTES=480
FUSSBALL_AUTOMATIC_SYNC_ENABLED=false
AUTOMATIC_POST_GENERATION_ENABLED=false
FUSSBALL_RESULT_MAX_AGE_HOURS=48
TEXT_GENERATOR_MODE=openai
IMAGE_GENERATOR_MODE=openai
OPENAI_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
HTTP_PORT=8080
META_PUBLIC_PORT=8081
TIMEZONE=Europe/Berlin
